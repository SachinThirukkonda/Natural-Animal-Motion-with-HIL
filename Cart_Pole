model = mujoco.MjModel.from_xml_string(xml)
data = mujoco.MjData(model)
pole_dof = model.joint("pole_hinge").dofadr[0]
push = 0
disable = 0
balance_e_i = 0
pos_e_i = 0
testing = 0
reward = 0

if testing:
    k_p = np.power(10, np.linspace(-1.5, -2, 6))
    k_i = np.power(10, np.linspace(-7, -10, 1))
    k_d = np.linspace(0.4, 0.2, 4)

   # prepare plotting axes
    _, ax = plt.subplots(1, 1)

    duration = 300 # (seconds)

    for k in k_i:
        mujoco.mj_resetDataKeyframe(model, data, 0)  # Reset the state to keyframe 0
        timevals = []
        stem_angle = []
        balance_e_i = 0
        pos_e_i = 0
        while data.time < duration:
            balance_e_p = data.sensor("pole_angle").data[0]
            balance_e_d = data.sensor("pole_angular_vel").data[0]
            balance, balance_e_i = pid_control(balance_e_p, balance_e_i, balance_e_d, k_p=0.006, k_i=6.3e-8, k_d=1.6e-2)
            pos = data.sensor("cart_pos").data[0]
            vel = data.sensor("cart_vel").data[0]
            pos_e_p = pos + np.sin(balance_e_p)*0.2
            pos_e_d = vel + np.sin(balance_e_d)*0.2
            position, pos_e_i = pid_control1(pos_e_p, pos_e_i, pos_e_d, k_p=0.01, k_i= 1e-7, k_d=0.2)
            mujoco.mj_step(model, data)
            reward += reward_func(data)
            timevals.append(data.time)
            stem_angle.append(reward_func(data))
        ax.plot(timevals, stem_angle, label='k_d = {:2.2g}'.format(k))

    ax.set_title('k_p tuning')
    ax.set_ylabel('angle')
    ax.set_xlabel('second')
    ax.legend(frameon=True);
    plt.tight_layout()
    plt.show()
else:
    with mujoco.viewer.launch_passive(model, data, key_callback=key_callback) as viewer:
        
        while viewer.is_running():
            if push:
                data.qvel[pole_dof] += .04
                push = 0
            balance_e_p = data.sensor("pole_angle").data[0]
            balance_e_d = data.sensor("pole_angular_vel").data[0]
            balance, balance_e_i = pid_control(balance_e_p, balance_e_i, balance_e_d, k_p=0.006, k_i=6.3e-8, k_d=1.6e-2)
            pos = data.sensor("cart_pos").data[0]
            pos0 = trajectory(data.time)
            vel = data.sensor("cart_vel").data[0]
            pos_e_p = pos + np.sin(balance_e_p)*0.2 - pos0
            pos_e_d = vel + np.sin(balance_e_d)*0.2
            position, pos_e_i = pid_control1(pos_e_p, pos_e_i, pos_e_d, k_p=0.01, k_i=1e-7, k_d=0.2)
            if abs(balance_e_p) < np.pi / 4 and  not disable:
                data.ctrl[0] = balance + position
            mujoco.mj_step(model, data)
