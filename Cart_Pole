def pid_control(e_p, e_i, e_d, k_p=0.006, k_i=6.3e-8, k_d=1.6e-2):
    #Integral error
    e_i += e_p
    return e_p * k_p + e_d * k_d - e_i * k_i, e_i

def pid_control1(e_p, e_i, e_d, k_p=0.006, k_i=6.3e-8, k_d=1.6e-2):
    #Integral error
    e_i += e_p
    return e_p * k_p + e_d * k_d + e_i * k_i, e_i

def trajectory(t):
    T= 100
    A = 0.1
    return 0
    return A* np.sin(2 * np.pi / T * t)

