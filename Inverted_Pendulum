    <accelerometer name="accelerometer" site="IMU"/>
  </sensor>
</mujoco>
"""

model = mujoco.MjModel.from_xml_string(xml)
data = mujoco.MjData(model)
e_i = np.zeros(3)
testing = 1

mujoco.mj_resetDataKeyframe(model, data, 0)  # Reset the state to keyframe 0


if testing:

    k_p = np.power(10, np.linspace(-0.5, -1.5, 6))
    k_i = np.power(10, np.linspace(-6, -8, 6))
    k_d = np.power(10, np.linspace(-2.3, -2.5, 3))

   # prepare plotting axes
    _, ax = plt.subplots(1, 1)

    duration = 80 # (seconds)

    for k in k_d:
        mujoco.mj_resetDataKeyframe(model, data, 0)  # Reset the state to keyframe 0
        timevals = []
        stem_angle = []
        e_i = np.zeros(3)
        R_1 = np.identity(3)

        while data.time < duration:

            pos0, vel0 = trajectory(data.time)
            R = np.reshape(data.xmat[1], (3,3))
            vel = data.qvel
            ctrl, e_i = pid_control(pos0, vel, vel0, R, e_i)
            data.ctrl = ctrl
            mujoco.mj_step(model, data)
            timevals.append(data.time)
            stem_angle.append(angle(R))
        ax.plot(timevals, stem_angle, label='k_d = {:2.2g}'.format(k))

    ax.set_title('k_p tuning')
    ax.set_ylabel('angle')
    ax.set_xlabel('second')
    ax.legend(frameon=True);
    plt.tight_layout()
    plt.show()
else:
    with mujoco.viewer.launch_passive(model, data) as viewer:
        while viewer.is_running():
            pos0, vel0 = trajectory(data.time)
            R = np.reshape(data.xmat[1], (3,3))
            vel = data.cvel[1, :3]
            ctrl, e_i = pid_control(pos0, vel, vel0, R, e_i)
            data.ctrl = ctrl
            
            mujoco.mj_step(model, data)
            viewer.sync()