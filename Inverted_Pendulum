import mujoco
import mujoco.viewer
import numpy as np
import matplotlib.pyplot as plt
#g = -1 --- k_p=0.4, k_i=1e-7, k_d=4e-3
#g = -9.81 --- k_p=0.05, k_i=4e-4, k_d=4e-3
def pid_control(pos0, vel, vel0, R, e_i, k_p=0.2, k_i=1e-7, k_d=4e-3):
  pos = np.array([0, 0, 1])

  # Orientation error
  d_pos = R.T @ pos0
  e_p = np.cross(pos, d_pos)

  # Derivative error
  e_d = vel - R.T @ vel0

  #Integral error
  e_i += e_p


  return e_p * k_p - e_d * k_d + e_i * k_i, e_i

def trajectory(t):
  direction = [np.array([np.sqrt(2), 0, np.sqrt(2)]), np.array([0, np.sqrt(2), np.sqrt(2)]), np.array([-np.sqrt(2), 0, np.sqrt(2)]), np.array([0, -np.sqrt(2), np.sqrt(2)])]
  return direction[int(t/1000)%4], np.zeros(3)

def pos_error(pos0, R):
  pos = np.array([0, 0, 1])

  # Orientation error
  d_pos = R.T @ pos0
  e_p = np.arcsin(np.linalg.norm(np.cross(pos, d_pos))/np.linalg.norm(d_pos))
  return e_p

def angle(R):
   vertical = np.array([0, 0, 1])
   pos = R @ vertical
   return np.arccos(np.dot(vertical, pos)) * 180 / (np.pi)


xml = """
